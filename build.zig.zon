.{
    .name = .zigvet,
    .version = "0.26.0",
    .fingerprint = 0x36366ba73c32fbe2, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    // No dependencies, by design: std.zig.Ast, the compiler's own parser, is
    // the only parser.
    .dependencies = .{},
    // What a project that depends on zigvet gets: a file build.zig reads
    // has to be listed here, or the dependency's build.zig does not compile
    // (#174).
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
    },
}
