.{
    .name = .zigvet,
    .version = "0.25.0",
    .fingerprint = 0x36366ba73c32fbe2, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    // No dependencies, by design: std.zig.Ast, the compiler's own parser, is
    // the only parser.
    .dependencies = .{},
    // What a project that depends on zigvet gets. build.zig embeds
    // scripts/install-gnarl.sh for the gnarl pin, so it is shipped too, or
    // the dependency's build.zig does not compile (#174).
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "scripts/install-gnarl.sh",
        "src",
        "README.md",
        "LICENSE",
    },
}
